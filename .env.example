# VoltRoute Environment Configuration Template
# Copy this file to .env (for frontend/ML) or configure environment variables for backend.
# DO NOT commit files containing actual secrets to version control.

# ----------------------------------------
# Backend Configuration (Spring Boot)
# ----------------------------------------
SERVER_PORT=8080

# Active Spring Profile:
# - 'dev' connects to PostgreSQL (requires POSTGRES_* or SPRING_DATASOURCE_* credentials)
# - 'local' runs zero-config with in-memory H2 database
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=voltroute_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Alternatively, configure via Spring standard datasource variables:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/voltroute_db
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_postgres_password_here

# JWT Security
# Minimum 256-bit (32+ character) secret string for HMAC-SHA256 signing
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long_replace_in_production
JWT_EXPIRATION_MS=86400000

# External Third-Party APIs
OPEN_CHARGE_MAP_API_KEY=your_open_charge_map_api_key_here
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here

# ML Microservice
ML_SERVICE_URL=http://localhost:8000

# ----------------------------------------
# Frontend Configuration (Vite / React)
# ----------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_TITLE=VoltRoute

# ==============================================================================
# VoltRoute Root .gitignore
# ==============================================================================

# OS & Desktop Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.swp
*.swo
*~
*.bak
*.orig

# IDEs & Editors
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sublime-workspace
.project
.classpath
.settings/
.factorypath

# Environment & Secret Files (CRITICAL: Never commit secrets)
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
*.pem
*.key
*.p12
*.jks
*.crt

# Build Artifacts & Logs
target/
backend/target/
dist/
frontend/dist/
frontend/dist-ssr/
*.class
*.jar
*.war
*.ear
!backend/.mvn/wrapper/maven-wrapper.jar
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
hs_err_pid*
replay_pid*

# Frontend (Node.js & Vite / React)
node_modules/
frontend/node_modules/
.vite/
frontend/.vite/
frontend/.eslintcache
frontend/.stylelintcache
coverage/
.nyc_output/

# Python / ML Microservice (Future)
ml-service/__pycache__/
ml-service/*.py[cod]
ml-service/*$py.class
ml-service/.pytest_cache/
ml-service/.venv/
ml-service/env/
ml-service/venv/
ml-service/ENV/
ml-service/*.joblib
ml-service/*.pkl
